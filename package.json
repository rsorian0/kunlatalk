{
  "name": "kunlatalk-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Site institucional da Kunlatalk em React + Vite.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node -e \"const fs=require('fs');['sobre','privacidade','termos','seguranca'].forEach(r=>{fs.mkdirSync('dist/'+r,{recursive:true});fs.copyFileSync('dist/index.html','dist/'+r+'/index.html');});\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.8"
  }
}
